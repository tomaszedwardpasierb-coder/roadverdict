# Read only by EAS Build, which uploads the Android app (mobile/) from the
# repository root. The app needs nothing outside its own folder, so the
# website, the git history and everything else here stay on this machine.
/*
!/mobile

# mobile/.gitignore, repeated: an .easignore replaces every .gitignore.
node_modules/
.expo/
dist/
web-build/
expo-env.d.ts
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision
.metro-health-check*
npm-debug.*
yarn-debug.*
yarn-error.*
.DS_Store
*.pem
.env*.local
*.tsbuildinfo
example
/mobile/ios
/mobile/android
