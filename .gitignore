# dependencies
node_modules/

# next.js
.next/
out/

# local data — never commit the price-log database
data/*.db
data/*.db-journal
data/*.db-wal
data/*.db-shm

# env files — never commit real values
.env
.env.local
.env.*.local

# misc
.DS_Store
*.log

# test output
coverage/
test-results/
playwright-report/
tsconfig.tsbuildinfo

# The Android app's Firebase config: EAS builds read it from disk (it is not
# in .easignore); kept out of this public repository anyway. Here rather
# than in mobile/.gitignore, which is part of the app's native fingerprint.
mobile/google-services.json
