{
  "expo": {
    "name": "RoadVerdict",
    "slug": "roadverdict-android-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "roadverdict",
    "userInterfaceStyle": "light",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "uk.co.roadverdict.app",
      "supportsTablet": false,
      "runtimeVersion": {
        "policy": "fingerprint"
      },
      "config": {
        "usesNonExemptEncryption": false
      },
      "infoPlist": {
        "NSFaceIDUsageDescription": "RoadVerdict uses Face ID to open the Vault and to confirm sign-ins on this iPhone.",
        "NSSpeechRecognitionUsageDescription": "RoadVerdict turns what you say into text so you can talk to the assistant instead of typing."
      }
    },
    "android": {
      "package": "uk.co.roadverdict.app",
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "backgroundColor": "#17181B",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "blockedPermissions": [
        "android.permission.SYSTEM_ALERT_WINDOW"
      ],
      "runtimeVersion": {
        "policy": "fingerprint"
      }
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#17181B",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 120
        }
      ],
      "expo-secure-store",
      "@react-native-community/datetimepicker",
      [
        "expo-image-picker",
        {
          "cameraPermission": "RoadVerdict uses the camera to photograph receipts, so the details can be read and logged for you.",
          "photosPermission": "RoadVerdict opens your photos so you can choose a receipt to scan.",
          "microphonePermission": "RoadVerdict uses the microphone so you can speak to the assistant instead of typing."
        }
      ],
      "expo-sharing",
      "expo-speech-recognition",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/android-icon-monochrome.png",
          "color": "#EE9A2E"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "68ced3b6-7dad-4040-9525-a6251fc9a3a8"
      }
    },
    "owner": "roadverdictwebs-team",
    "updates": {
      "url": "https://u.expo.dev/68ced3b6-7dad-4040-9525-a6251fc9a3a8"
    }
  }
}
