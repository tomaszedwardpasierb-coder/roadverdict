# Real environment variables this app actually depends on, grouped by
# purpose. Never put real values in this file - copy it to .env.local
# (already gitignored) and fill that in instead.
#
# This previously described the app as a secrets-free "quote checker"
# prototype with SendGrid/Stripe placeholders that were never used -
# stale from an earlier stage of the project. This reflects what's
# actually referenced in src/ today (checked via a grep across the
# codebase, not by memory).

# --- Database ---
COSMOS_CONNECTION_STRING=

# --- File storage (receipt/attachment uploads) ---
AZURE_STORAGE_CONNECTION_STRING=

# --- External data APIs ---
VDG_API_KEY=
GEMINI_API_KEY=

# --- Email (magic-link login, notifications) ---
RESEND_API_KEY=

# --- Admin login (/tomasz) ---
ADMIN_PASSWORD_HASH=
ADMIN_TOTP_SECRET=

# --- Scheduled job authorization (cron routes) ---
CRON_SECRET=

# --- Monitoring (Application Insights via Entra ID app registration) ---
APPLICATIONINSIGHTS_CONNECTION_STRING=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_TENANT_ID=

# --- Misc ---
# Base URL used when building absolute links (emails, share links).
APP_URL=

# Not set here: NEXT_RUNTIME, NODE_ENV, WEBSITE_HOSTNAME,
# WEBSITE_INSTANCE_ID, WEBSITE_RESOURCE_GROUP, WEBSITE_SITE_NAME, and
# REGION_NAME are injected automatically by Azure App Service at
# runtime - nothing to configure for these locally or in App Settings.